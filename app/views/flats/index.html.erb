<div class="relative flex flex-col justify-center">
  <% @flats.each do |flat| %>
    <div class="block max-w-sm p-6 m-3 bg-white border border-gray-200 rounded-lg shadow hover:bg-gray-100">
      <table>
        <thead>
          <tr>
            <th colspan="2">
              <%= flat.attr["Adresse"] %>
            </th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>
              <%= flat.external_id %>
            </td>
          </tr>
          <tr>
            <td>
              <%= link_to "Link zur Wohnung", flat.link, {target: "_blank", class: "text-blue-500 hover:text-blue-700"} %>
            </td>
          </tr>
          <% flat.attr.except("Adresse").each do |key, value| %>
            <tr>
              <td>
                <strong>
                  <%= "#{key}:" %>
                </strong>
              </td>
              <td>
                <%= value %>
              </td>
            </tr>
          <% end %>
          <tr>
            <td>
              <strong>
                Gefunden um:
              </strong>
            </td>
            <td>
              <%= l flat.created_at %>
            </td>
          </tr>
          <tr>
            <td>
              <strong>
                Letztes Update:
              </strong>
            </td>
            <td>
              <%= l flat.updated_at %>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
